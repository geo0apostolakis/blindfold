# Blindfold: every setting the app reads. Copy to .env.local.
# For the local demo, `npm run setup` writes .env.local for you.

# Chain: local | testnet (Base Sepolia) | mainnet (Base)
NEXT_PUBLIC_BLINDFOLD_CHAIN=local
# Optional: override the chain's default RPC
NEXT_PUBLIC_RPC_URL=
# The dollar stablecoin credits are paid in. On testnet and mainnet use the
# USDC contract Circle lists for that chain. Empty = buying credits is off.
NEXT_PUBLIC_BLINDFOLD_TOKEN=
NEXT_PUBLIC_BLINDFOLD_SYMBOL=USDC
NEXT_PUBLIC_BLINDFOLD_DECIMALS=6
# Where payments are sent. The app only reads transfers into it; it never
# needs this wallet's key.
NEXT_PUBLIC_BLINDFOLD_TREASURY=

# OpenRouter. Leave the key empty for demo mode (canned answers).
OPENROUTER_API_KEY=
# The most the app will ever plan to spend. It also reads the key limit and the
# account balance and uses the lowest of the three.
OPENROUTER_BUDGET_USD=20

# Purchase bounds, in credits (8,000 credits = $1 paid)
BLINDFOLD_MIN_REDEEM_CREDITS=500
BLINDFOLD_MAX_REDEEM_CREDITS=50000
BLINDFOLD_MAX_CREDITS_PER_WALLET_DAY=100000
# Blocks to wait before crediting a payment
BLINDFOLD_CONFIRMATIONS=1

# Production only: from `npm run gen-keys`. Development generates its own.
BLINDFOLD_BLIND_KEYS=
# Optional: where the JSON store lives (default .data/store.json)
BLINDFOLD_STORE_FILE=
# Optional: build output folder, so a production build can run beside `next dev`
NEXT_DIST_DIR=
